# URL de l'API : /api/v1, relaye par le serveur Vite vers le backend
# (Backend_TerrainApp, docker compose up, port 8090). Fonctionne aussi via un
# tunnel (VS Code, ngrok) ou depuis une tablette du reseau local.
VITE_API_BASE_URL=/api/v1

# Contact support (feuille "Besoin d'aide ?" en bas de page).
VITE_SUPPORT_TELEPHONE=+221770000000
VITE_SUPPORT_EMAIL=support@exemple.sn

# Adresse de l'App Client (bouton "Aperçu" des terrains publiés).
# Vide en developpement : meme machine, port 5180. En Docker : URL_APP_CLIENT.
# VITE_URL_APP_CLIENT=https://reserver.mon-complexe.sn

# Marque du complexe (marque blanche). Vide = TerrainApp. Memes valeurs que l'App Client.
# En developpement : VITE_MARQUE_* ; en Docker : MARQUE_* (sans VITE_).
# VITE_MARQUE_NOM=Arena Thiès
# VITE_MARQUE_NOM_ACCENT=Thiès
# VITE_MARQUE_INITIALES=AT
# VITE_MARQUE_LOGO_URL=
# VITE_MARQUE_ETABLISSEMENT=          # nom sous la marque (facultatif)
# VITE_MARQUE_COULEUR=#1F7A4D
# VITE_MARQUE_COULEUR_CLAIRE=
